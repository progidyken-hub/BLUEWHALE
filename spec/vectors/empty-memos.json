{
  "vector_version": "1.0.0",
  "description": "Normative handling of empty MEMO_TEXT values. A MEMO_TEXT whose value is omitted, null, \"\" or only ASCII whitespace (space, tab, LF, CR) MUST resolve to memo type none in every SDK: no routing ID from the memo and no memo-related warnings (MEMO_TEXT_UNROUTABLE, MEMO_IGNORED_FOR_MUXED), for G and M destinations alike. Non-ASCII whitespace is content. Go has no null string, so runners map null/omitted to \"\". Warnings are compared by code and severity, in order.",
  "cases": [
    {
      "id": "g-text-omitted",
      "description": "MEMO_TEXT with memoValue omitted on a G destination is treated as no memo",
      "input": {
        "destination": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "memoType": "text"
      },
      "expected": {
        "effectiveMemoType": "none",
        "warnings": [],
        "destinationBaseAccount": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "routingId": null,
        "routingSource": "none"
      }
    },
    {
