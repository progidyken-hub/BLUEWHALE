    { "pattern": "routing_id_canonical", "input": "１２３", "match": false, "description": "fullwidth digits (U+FF11..U+FF13)" },
    { "pattern": "routing_id_canonical", "input": "", "match": false, "description": "empty string" },

    { "pattern": "memo_numeric", "input": "123", "match": true, "description": "plain digits" },
