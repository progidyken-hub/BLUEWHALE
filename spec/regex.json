    { "pattern": "memo_numeric", "input": "123 ", "match": false, "description": "trailing space" },
    { "pattern": "memo_numeric", "input": "123\n", "match": false, "description": "trailing LF" },
    { "pattern": "memo_numeric", "input": "1 23", "match": false, "description": "interior space" },
