{
  "name": "@redishfish/bluewhale-core",
  "version": "1.3.0",
  "description": "TypeScript implementation of the Bluewhale",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "bun": "./dist/index.mjs",
      "deno": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "stellar-route": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bun": "bun test ./tests/runtime/bun.smoke.ts",
    "test:deno": "deno test --allow-read --allow-env tests/runtime/deno.smoke.ts",
    "lint": "eslint src/**/*.ts",
    "check:types": "attw --pack . --profile node16",
    "mutation": "stryker run",
    "mutation:ci": "stryker run --reporters progress,html,json"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=10.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@redishfish/bluewhale-spec": "workspace:*",
    "@stellar/stellar-sdk": "^17.4.0",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/vitest-runner": "^8.6.0",
    "@stryker-mutator/typescript-checker": "^8.6.0",
    "eslint": "^10.15.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "commander": "^15.1.0"
  }
}
